{
  "name": "thandra-admin",
  "version": "1.0.0",
  "private": true,
  "description": "Thandra Cars admin app",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "export:check": "expo export --platform android --output-dir /tmp/thandra-admin-export",
    "test": "jest",
    "test:contract": "jest -c jest.contract.config.js"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-community/datetimepicker": "9.1.0",
    "@tanstack/react-query": "^5.108.0",
    "@types/jest": "29.5.14",
    "expo": "~57.0.26",
    "expo-asset": "~57.0.21",
    "expo-constants": "~57.0.24",
    "expo-crypto": "~57.0.4",
    "expo-font": "~57.0.4",
    "expo-image-picker": "~57.0.21",
    "expo-linking": "~57.0.14",
    "expo-router": "~57.0.31",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.11",
    "expo-status-bar": "~57.0.1",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.6",
    "react": "19.2.3",
    "react-dom": "^19.2.3",
    "react-native": "0.86.3",
    "react-native-paper": "^5.15.5",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-webview": "13.16.1"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/react": "~19.2.2",
    "react-test-renderer": "^19.2.3",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/.expo/",
      "contract.test.ts"
    ]
  }
}
